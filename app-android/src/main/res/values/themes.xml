<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame: no white flash before Compose draws. -->
    <style name="Theme.Valen" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/valen_background</item>
        <item name="android:colorBackground">@color/valen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/valen_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- The activity's theme: the same window, plus Android 12's splash on API 31+ (values-v31). -->
    <style name="Theme.Valen.Starting" parent="@style/Theme.Valen" />
</resources>
